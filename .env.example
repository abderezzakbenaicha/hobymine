# ---- API ----
PORT=4000
# Bind all interfaces so a phone on the same Wi-Fi can reach the API.
# Set HOST=127.0.0.1 to restrict it to this computer.
HOST=0.0.0.0
JWT_SECRET=replace-me-with-a-long-random-string
WEB_ORIGIN=http://localhost:5173

# Leave DATABASE_URL empty to use the embedded PostgreSQL engine (PGlite).
# For a real PostgreSQL server, set e.g.:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ofo
#
# Supabase (IPv4 session pooler; DDL needs the database password, not an API key):
# DATABASE_URL=postgresql://postgres.<ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require
DATABASE_URL=

# PGlite data directory (used when DATABASE_URL is empty)
PGLITE_DIR=

# ---- Supabase ----
# Project URL and the *publishable* key. Safe for the browser and the APK.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Server-only. Never expose this to the web app and never prefix it with VITE_.
# It bypasses Row Level Security, so only set it if a server task needs it.
# The API also uses it to write uploads to Supabase Storage (bucket "media").
SUPABASE_SECRET_KEY=

# Bucket that holds photos, voice notes and chat attachments once the API runs
# on a cloud host. The API creates it on boot when it does not exist.
SUPABASE_STORAGE_BUCKET=media

# ---- Supabase schema push (npm run db:supabase) ----
# A database password or connection string is required to create tables; API
# keys cannot run DDL. Get it from Project Settings -> Database, or Connect ->
# Session pooler. Set ONE of the following:
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Or a personal access token from https://supabase.com/dashboard/account/tokens:
# SUPABASE_ACCESS_TOKEN=sbp_...

# ---- Web ----
# Only needed when the web app is hosted separately from the API.
# VITE_API_URL=https://api.example.com

# The web app reads its Supabase settings from apps/web/.env.local:
#   VITE_SUPABASE_URL=https://your-project-ref.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Only publishable keys belong in VITE_* variables.
