# The API runs on Railway (see DEPLOY.md). Physical devices cannot use
# localhost, so the packaged APK needs an absolute HTTPS address.
#
# This is only the build-time default: users can still change it at runtime
# under Settings -> Server connection if the service is renamed.
#
# The Railway deploy itself overrides this with the service-level VITE_API_URL
# variable, so the same commit can serve the PWA from its own origin.
VITE_API_URL=https://hobymine-api-production.up.railway.app
