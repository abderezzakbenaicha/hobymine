# Copy to .env.production (or set the variable in your shell) before building the APK.
# For a phone on the same Wi-Fi as the development machine, use the machine's LAN IP.
# For a deployed backend, use its HTTPS URL (required for production builds).
#
# The address baked in here is only the default: the installed app can override it
# at runtime under Welcome → Server (or Profile → Server connection), so a changing
# LAN IP does not require a rebuild.
VITE_API_URL=https://hobymine-api.onrender.com

# ---- Supabase (browser client) ----
# Only publishable keys belong in VITE_* variables: Vite inlines them into the
# shipped JavaScript. A secret / service_role key here would leak full database
# access to anyone who opens the app. Copy this file to `.env.local` to use it.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
